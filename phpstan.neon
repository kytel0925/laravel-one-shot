includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - src/

    level: 7

    ignoreErrors:
        # Shared model traits (app/Models/Traits) wait for the first aggregate that uses them.
        - identifier: trait.unused
