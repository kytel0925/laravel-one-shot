<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <!--
        Tests run against the Docker Compose services, never SQLite or array
        drivers: the `testing` PostgreSQL database (etc/docker/postgres),
        Redis databases 2 and 3, a dedicated RabbitMQ queue and Mailpit.
        Host names and credentials come from .env, so the same file works in
        the `app` container and in CI service containers.
    -->
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="CACHE_STORE" value="redis" force="true"/>
        <env name="SESSION_DRIVER" value="redis" force="true"/>
        <env name="REDIS_DB" value="2" force="true"/>
        <env name="REDIS_CACHE_DB" value="3" force="true"/>
        <env name="REDIS_PREFIX" value="testing-" force="true"/>
        <env name="QUEUE_CONNECTION" value="rabbitmq" force="true"/>
        <env name="RABBITMQ_QUEUE" value="testing" force="true"/>
        <env name="MAIL_MAILER" value="smtp" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
